# App Configuration
NODE_ENV=production
APP_PORT=3000
BACKEND_PORT=5000

# MongoDB Remote VM Configuration
MONGODB_HOST=mongodb-vm          # Indirizzo IP o hostname della VM con MongoDB
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=password123
MONGODB_DB=servicecheck

# Backend API Configuration
VITE_API_URL=http://localhost:5000/api

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=*

# Optional: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
